{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDevBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::myapp-dev-*", "arn:aws:s3:::myapp-dev-*/*"]
    },
    {
      "Sid": "StartStopDevEC2FromOffice",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances", "ec2:Describe*"],
      "Resource": "*",
      "Condition": {"IpAddress": {"aws:SourceIp": "203.0.113.0/24"}}
    },
    {
      "Sid": "NeverDeleteProdData",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteBucket"],
      "Resource": ["arn:aws:s3:::myapp-prod-*", "arn:aws:s3:::myapp-prod-*/*"]
    },
    {
      "Sid": "RequireMFAForIAM",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": "*",
      "Condition": {"Bool": {"aws:MultiFactorAuthPresent": "false"}}
    }
  ]
}
